//@version=5
indicator("1-Min Day Trading System", overlay=true, max_labels_count=500)

// === Trend ===
fastLength = input.int(9, title="Fast EMA Length", group="Trend")
slowLength = input.int(21, title="Slow EMA Length", group="Trend")
fastEMA = ta.ema(close, fastLength)
slowEMA = ta.ema(close, slowLength)
vwapValue = ta.vwap(hlc3)

// === Momentum ===
rsiLength = input.int(14, title="RSI Length", group="Momentum")
rsiLongMin = input.int(50, title="Min RSI for Longs", group="Momentum")
rsiShortMax = input.int(50, title="Max RSI for Shorts", group="Momentum")
rsiOverbought = input.int(80, title="Skip Longs Above (too extended)", group="Momentum")
rsiOversold = input.int(20, title="Skip Shorts Below (too extended)", group="Momentum")
rsiValue = ta.rsi(close, rsiLength)

// === Volume ===
volLength = input.int(20, title="Volume Avg Length", group="Volume")
volMultiplier = input.float(1.2, title="Min Volume Multiplier", minval=0.1, step=0.1, group="Volume")
volumeOk = volume > ta.sma(volume, volLength) * volMultiplier

// === Volatility ===
atrLength = input.int(14, title="ATR Length", group="Volatility")
atrMultiplier = input.float(1.0, title="Min ATR Multiplier", minval=0.1, step=0.1, group="Volatility")
atrValue = ta.atr(atrLength)
volatilityOk = atrValue > ta.sma(atrValue, atrLength) * atrMultiplier

// === Session Filter ===
useSessionFilter = input.bool(true, title="Only trade during regular session", group="Session")
sessionInput = input.session("0930-1600", title="Session (exchange time)", group="Session")
inSession = not useSessionFilter or not na(time(timeframe.period, sessionInput))

// === Risk Management ===
slAtrMult = input.float(1.5, title="Stop Loss (x ATR)", minval=0.1, step=0.1, group="Risk")
tpAtrMult = input.float(2.5, title="Take Profit (x ATR)", minval=0.1, step=0.1, group="Risk")

// === Signal Logic ===
bullishCross = ta.crossover(fastEMA, slowEMA)
bearishCross = ta.crossunder(fastEMA, slowEMA)

trendUpAligned = close > vwapValue and fastEMA > slowEMA
trendDownAligned = close < vwapValue and fastEMA < slowEMA

momentumLongOk = rsiValue > rsiLongMin and rsiValue < rsiOverbought
momentumShortOk = rsiValue < rsiShortMax and rsiValue > rsiOversold

buySignal = bullishCross and trendUpAligned and momentumLongOk and volumeOk and volatilityOk and inSession
sellSignal = bearishCross and trendDownAligned and momentumShortOk and volumeOk and volatilityOk and inSession

// === Plots ===
fastPlot = plot(fastEMA, title="Fast EMA", color=color.new(color.aqua, 0), linewidth=2)
slowPlot = plot(slowEMA, title="Slow EMA", color=color.new(color.orange, 0), linewidth=2)
fill(fastPlot, slowPlot, color=fastEMA > slowEMA ? color.new(color.green, 90) : color.new(color.red, 90))
plot(vwapValue, title="VWAP", color=color.new(color.purple, 0), linewidth=2)

plotshape(buySignal, title="Buy Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="BUY", textcolor=color.white)
plotshape(sellSignal, title="Sell Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL", textcolor=color.white)

// === Risk Labels (suggested stop/target based on ATR at signal time) ===
if buySignal
    entryPrice = close
    stopPrice = entryPrice - atrValue * slAtrMult
    targetPrice = entryPrice + atrValue * tpAtrMult
    label.new(bar_index, low, text="SL " + str.tostring(stopPrice, format.mintick) + "\nTP " + str.tostring(targetPrice, format.mintick), style=label.style_label_up, color=color.new(color.green, 70), textcolor=color.white, size=size.tiny)

if sellSignal
    entryPrice = close
    stopPrice = entryPrice + atrValue * slAtrMult
    targetPrice = entryPrice - atrValue * tpAtrMult
    label.new(bar_index, high, text="SL " + str.tostring(stopPrice, format.mintick) + "\nTP " + str.tostring(targetPrice, format.mintick), style=label.style_label_down, color=color.new(color.red, 70), textcolor=color.white, size=size.tiny)

// === Session shading ===
bgcolor(useSessionFilter and not inSession ? color.new(color.gray, 90) : na, title="Outside Session")

// === Alerts ===
alertcondition(buySignal, title="Buy Signal", message="1-min system BUY: trend+momentum+volume+volatility aligned")
alertcondition(sellSignal, title="Sell Signal", message="1-min system SELL: trend+momentum+volume+volatility aligned")
