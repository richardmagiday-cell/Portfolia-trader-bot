# ── Discord ──────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Comma-separated channel IDs to monitor (right-click channel → Copy ID)
DISCORD_CHANNEL_IDS=123456789012345678,987654321098765432

# ── Alpaca (paper trading) ────────────────────────────────────────────────────
# Sign up at https://alpaca.markets — paper trading is free
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# Set to "paper" to use paper trading endpoint, "live" for real money
ALPACA_MODE=paper

# ── Bot behavior ─────────────────────────────────────────────────────────────
# DRY_RUN=true prints signals but never places orders
DRY_RUN=true

# Max dollars to risk per trade (used when no quantity specified)
MAX_TRADE_USD=500

# ── Forum scraper (optional) ─────────────────────────────────────────────────
# Comma-separated URLs to poll for trade signals
FORUM_URLS=
# How often to check each URL, in seconds
FORUM_POLL_INTERVAL=60
